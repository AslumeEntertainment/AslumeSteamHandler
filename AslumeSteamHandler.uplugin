	"CanContainContent": true,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "AslumeSteamHandlerModule",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit"
		}
	],
	"PostBuildSteps":
	{
		"Win64": [
			"if not exist $(PluginDir)\\Binaries\\ThirdParty\\SteamHandlerLibrary\\RedistributableBin\\win64\\steam_api64.dll mkdir $(PluginDir)\\Binaries\\ThirdParty\\SteamHandlerLibrary\\RedistributableBin\\win64",
			"if not exist $(PluginDir)\\Binaries\\ThirdParty\\SteamHandlerLibrary\\RedistributableBin\\win64\\steam_api64.dll copy $(PluginDir)\\Source\\ThirdParty\\SteamHandlerLibrary\\RedistributableBin\\win64\\steam_api64.dll $(PluginDir)\\Binaries\\ThirdParty\\SteamHandlerLibrary\\RedistributableBin\\win64"
		]
	},
	"DisallowedPlugins": [
		{
			"Name": "OnlineSubsystemSteam",
			"Comment": ""
		},
		{
			"Name": "SteamShared",
			"Comment": ""
		}
	],
	"Plugins": [
		{
			"Name": "OnlineSubsystem",
			"Enabled": true
		},
		{
			"Name": "OnlineSubsystemNull",
			"Enabled": true
		},
		{
			"Name": "OnlineSubsystemUtils",
			"Enabled": true,
			"Optional": true
		}
	]
}